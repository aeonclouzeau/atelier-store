# Neon Postgres connection string (use the pooled URL from the Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Required: at least 32 random characters, the app refuses to start auth with a weak one.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Exposed to the browser for the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
